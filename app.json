{
  "expo": {
    "name": "Recipeek",
    "slug": "recipeek",
    "owner": "justay123",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "recipeek",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "android": {
      "package": "com.justa.recipeek",
      "adaptiveIcon": {
        "backgroundColor": "#C45C26",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "recipeek"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.justa.recipeek",
      "supportsTablet": true
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "backgroundColor": "#F6F0E6"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#C45C26",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Recipeek uses your photo gallery so you can add pictures to recipes and scan saved magazine pages.",
          "cameraPermission": "Recipeek uses the camera to photograph dishes and to scan magazine and cookbook pages."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "31355b57-be55-4c17-837f-a4f1525563f4"
      }
    }
  }
}
