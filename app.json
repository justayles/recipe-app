{
  "expo": {
    "name": "Recipeek",
    "slug": "recipeek",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "recipeek",
    "userInterfaceStyle": "automatic",
    "platforms": ["android", "ios", "web"],
    "android": {
      "package": "com.justa.recipeek",
      "adaptiveIcon": {
        "backgroundColor": "#C45C26",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [{ "scheme": "recipeek" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "ios": {
      "bundleIdentifier": "com.justa.recipeek",
      "supportsTablet": true
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "backgroundColor": "#F6F0E6"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#C45C26",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Recipeek uses your photos so you can add pictures to recipes and scan saved magazine pages.",
          "cameraPermission": "Recipeek uses the camera to scan magazine and cookbook pages."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
