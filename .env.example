# Copy to `.env` and fill in. Get local values from `npx supabase status`.
#
# For local dev, keep the host as 127.0.0.1 - the app swaps it for your dev
# machine's LAN IP automatically (see src/lib/supabase.ts), so Expo Go on a
# phone and the Android emulator both work.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54331
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# PostHog project API key (phc_...) — public, used for the recipe-scan feature flag.
# Same project as POSTHOG_API_KEY in supabase/functions/.env.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Scan uses the local scan-recipe function. Put the OpenAI key in
# supabase/functions/.env (copy supabase/.env.example), not here —
# it must not ship in the app bundle.
